{
  "name": "froot-fullstack",
  "version": "1.1.1",
  "description": "High-performance Next.js alternative for Froot — Preact SSR, nested layouts, dynamic routes, SSG, and Markdown engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./preact": {
      "types": "./dist/preact/index.d.ts",
      "import": "./dist/preact/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/*.test.ts"
  },
  "keywords": [
    "froot",
    "fullstack",
    "nextjs",
    "preact",
    "ssr",
    "ssg",
    "layouts",
    "router"
  ],
  "author": "OrbitNorth LLC",
  "license": "MIT",
  "dependencies": {
    "frootjs": "^1.0.6",
    "preact": "^11.1.0",
    "preact-render-to-string": "^6.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.8.0"
  }
}
