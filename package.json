{
  "name": "frootjs",
  "version": "1.0.0",
  "description": "High-performance, ultra-flexible, TypeScript-native web framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/rpc.d.ts",
      "import": "./dist/client/rpc.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    },
    "./adapters/aws-lambda": {
      "types": "./dist/adapters/aws-lambda.d.ts",
      "import": "./dist/adapters/aws-lambda.js"
    },
    "./runtime": {
      "types": "./dist/utils/runtime.d.ts",
      "import": "./dist/utils/runtime.js"
    },
    "./jsx": {
      "types": "./dist/jsx/index.d.ts",
      "import": "./dist/jsx/index.js"
    },
    "./jsx/jsx-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./jsx/jsx-dev-runtime": {
      "types": "./dist/jsx/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx/jsx-dev-runtime.js"
    },
    "./streaming": {
      "types": "./dist/streaming/index.d.ts",
      "import": "./dist/streaming/index.js"
    },
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "import": "./dist/ws/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./jwt": {
      "types": "./dist/auth/jwt.d.ts",
      "import": "./dist/auth/jwt.js"
    },
    "./basic-auth": {
      "types": "./dist/auth/basic.d.ts",
      "import": "./dist/auth/basic.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "import": "./dist/html/index.js"
    },
    "./cors": {
      "types": "./dist/middleware/cors.d.ts",
      "import": "./dist/middleware/cors.js"
    },
    "./logger": {
      "types": "./dist/middleware/logger.d.ts",
      "import": "./dist/middleware/logger.js"
    },
    "./timing": {
      "types": "./dist/middleware/timing.d.ts",
      "import": "./dist/middleware/timing.js"
    },
    "./security": {
      "types": "./dist/middleware/security.d.ts",
      "import": "./dist/middleware/security.js"
    },
    "./bearer-auth": {
      "types": "./dist/middleware/bearer-auth.d.ts",
      "import": "./dist/middleware/bearer-auth.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "import": "./dist/openapi/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/*.test.ts",
    "prepublishOnly": "npm run build && npm run test",
    "web": "node --experimental-strip-types web/server.ts",
    "bench": "node examples/benchmark.ts",
    "example:basic": "node examples/basic.ts",
    "example:streaming": "node examples/streaming.ts",
    "example:rpc": "node examples/rpc-demo.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbitnorth/froot.git"
  },
  "homepage": "https://github.com/orbitnorth/froot#readme",
  "bugs": {
    "url": "https://github.com/orbitnorth/froot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "froot",
    "framework",
    "web",
    "http",
    "fast",
    "typescript",
    "performance",
    "router",
    "wintercg",
    "api"
  ],
  "author": "OrbitNorth LLC",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.0"
  }
}
